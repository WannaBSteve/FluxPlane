FLUXPLANE_DB_PASSWORD=change-this-local-password
FLUXPLANE_DEMO_DB_PASSWORD=change-this-demo-password
FLUXPLANE_API_KEY=change-this-instance-key
# Optional distinct keys for non-administrator console access.
FLUXPLANE_OPERATOR_API_KEY=
FLUXPLANE_VIEWER_API_KEY=
# Optional OpenAI-compatible model for natural-language analysis (API service only).
FLUXPLANE_ANALYSIS_BASE_URL=
FLUXPLANE_ANALYSIS_MODEL=
FLUXPLANE_ANALYSIS_API_KEY=
FLUXPLANE_ANALYSIS_TIMEOUT_SECONDS=60
FLUXPLANE_WEB_PORT=8088
# Optional comma-separated hosts for administrator-approved HTTP JSON sources.
FLUXPLANE_HTTP_ALLOWED_HOSTS=
FLUXPLANE_QUERY_WORKERS=1
FLUXPLANE_BACKGROUND_WORKERS=1
# Set to 10 only in an isolated instance when running the worker recovery demo.
FLUXPLANE_WORKER_LEASE_SECONDS=120
FLUXPLANE_BACKGROUND_BORROW_GRACE_MS=500
FLUXPLANE_RESOURCE_CPU_MILLICORES=2000
FLUXPLANE_RESOURCE_MEMORY_MB=2048
FLUXPLANE_REMOTE_POLL_SECONDS=60
FLUXPLANE_MATERIALIZATION_MAX_BYTES=268435456
FLUXPLANE_MATERIALIZATION_STALE_SECONDS=86400
FLUXPLANE_POSTGRES_FULL_RECONCILE_SECONDS=86400
FLUXPLANE_HTTP_FULL_RECONCILE_SECONDS=86400

