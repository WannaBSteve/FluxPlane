{
  "schema_version": 2,
  "experiment": "cfpb_response_agentic_fusion",
  "protocol": {
    "identity": "cfpb_response_agentic_fusion",
    "research_role": "text-tabular feature fusion and agentic decision quality",
    "task": "Predict the company's eventual complaint response from information available before that response is produced.",
    "target": "Company response to consumer",
    "split": "chronological 60/20/20 train/validation/test over all selected records",
    "metrics": [
      {
        "name": "macro_average_precision",
        "direction": "maximize",
        "role": "primary",
        "rationale": "Risk-sensitive one-vs-rest ranking quality that does not hide rare response classes."
      },
      {
        "name": "macro_ovr_auroc",
        "direction": "maximize",
        "role": "secondary",
        "rationale": "Comparable with the AUROC protocol used by recent text-tabular benchmarks."
      },
      {
        "name": "macro_f1",
        "direction": "maximize",
        "role": "secondary",
        "rationale": "Measures the final hard decision equally across response classes."
      },
      {
        "name": "expected_calibration_error",
        "direction": "minimize",
        "role": "diagnostic",
        "rationale": "Determines whether confidence is useful for selective LLM escalation."
      }
    ],
    "baselines": [
      {
        "identity": "b0_majority",
        "family": "constant",
        "modalities": [
          "label_prior"
        ],
        "description": "Most frequent training response; sanity check only.",
        "comparison_role": "sanity"
      },
      {
        "identity": "b1_tfidf_lr",
        "family": "linear",
        "modalities": [
          "text"
        ],
        "description": "Word 1-2 gram TF-IDF with class-balanced logistic regression.",
        "comparison_role": "required"
      },
      {
        "identity": "b2_structured_lr",
        "family": "linear",
        "modalities": [
          "structured"
        ],
        "description": "One-hot pre-decision fields with class-balanced logistic regression.",
        "comparison_role": "required"
      },
      {
        "identity": "b3_early_fusion_lr",
        "family": "linear",
        "modalities": [
          "text",
          "structured"
        ],
        "description": "Single classifier over concatenated text and structured features.",
        "comparison_role": "required"
      },
      {
        "identity": "b4_late_fusion",
        "family": "ensemble",
        "modalities": [
          "text",
          "structured"
        ],
        "description": "Validation-selected probability fusion of the two unimodal agents.",
        "comparison_role": "required"
      },
      {
        "identity": "b5_all_ling",
        "family": "large_model",
        "modalities": [
          "text",
          "structured",
          "retrieval"
        ],
        "description": "Ling judges every record; quality upper bound, not the gain denominator.",
        "comparison_role": "upper_bound"
      }
    ],
    "success_criteria": [
      "The proposed method must beat both unimodal baselines and early fusion.",
      "Removing text, structured evidence, or retrieval must each be reported.",
      "The 30% claim uses relative macro-average-precision gain over B1 and is also reported against the strongest required baseline.",
      "All methods use the same complete chronological test partition."
    ],
    "public_anchor": "MulTaBench extended Consumer Complaints protocol (NeurIPS 2026)",
    "primary_metric": "macro_average_precision"
  },
